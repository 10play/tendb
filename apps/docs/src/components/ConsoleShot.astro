---
/**
 * A console screenshot that follows the docs theme: the dark capture in dark
 * mode, the light capture in light mode, with a visible caption. Pair with
 * the .dark-only/.light-only rules in styles/custom.css.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  dark: ImageMetadata;
  light: ImageMetadata;
  alt: string;
  caption?: string;
}

const { dark, light, alt, caption } = Astro.props;
---

<figure class="console-shot">
  <Image src={dark} alt={alt} class="dark-only" loading="eager" />
  <Image src={light} alt={alt} class="light-only" loading="eager" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
